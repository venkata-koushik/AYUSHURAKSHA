DATABASE_URL=sqlite:///./ayush.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ayush

# Deployment controls
SEED_DEMO_DATA=false
ENABLE_BACKGROUND_SCHEDULER=true
CORS_ALLOWED_ORIGINS=*
TRUSTED_HOSTS=*

JWT_SECRET_KEY=ayush-dev-secret-change-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

SENDGRID_API_KEY=
EMAIL_FROM=no-reply@ayush.local
OTP_EMAIL_OVERRIDE=koushik.chinnu.2007@gmail.com

REDIS_URL=redis://localhost:6379/0
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Optional: LLM-backed clinical reasoning for /api/chat and /api/consultation/summarize
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional external AI endpoints (if you do not use OPENAI_API_KEY)
SPEECH_TO_TEXT_API=
TEXT_SUMMERISATION_API=

# WebRTC signaling/ICE
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
